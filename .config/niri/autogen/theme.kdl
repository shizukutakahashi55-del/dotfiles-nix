// Auto-generado por OozeShell (APPEARANCE). No editar a mano.
// Se regenera cada vez que cambias algo desde el panel de apariencia.
layout {
    gaps 8
    border {
        off
    }
    shadow {
        off
    }
}

window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
    background-effect {
        blur true
    }
}

blur {
    passes 1
    offset 3.0
}
