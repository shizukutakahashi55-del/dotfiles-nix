// Auto-generado por OozeShell (APPEARANCE). No editar a mano.
// Se regenera cada vez que cambias algo desde el panel de apariencia.
layout {
    gaps 6
    focus-ring {
        off
    }
    border {
        on
        width 3
    }
    shadow {
        off
    }
}

window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
    background-effect {
        blur true
    }
}

blur {
    passes 1
    offset 1.0
}
