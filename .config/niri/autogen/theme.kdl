// Auto-generado por OozeShell (APPEARANCE). No editar a mano.
// Se regenera cada vez que cambias algo desde el panel de apariencia.
layout {
    gaps 6
    focus-ring {
        off
    }
    border {
        on
        width 3
    }
    shadow {
        off
    }
}

window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
    background-effect {
        blur true
    }
}

layer-rule {
    match namespace="^(oozeshell|quickshell)-"
    background-effect {
        xray false
    }
}

blur {
    passes 2
    offset 3.0
}
