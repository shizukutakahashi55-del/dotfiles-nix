// Auto-generado por OozeShell (APPEARANCE). No editar a mano.
// Perfil: smooth
animations {
    workspace-switch {
        spring damping-ratio=1.00 stiffness=900 epsilon=0.0001
    }
    window-open {
        duration-ms 180
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 160
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=1.00 stiffness=700 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.00 stiffness=700 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.00 stiffness=700 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.60 stiffness=1000 epsilon=0.0001
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=1.00 stiffness=700 epsilon=0.0001
    }
}
