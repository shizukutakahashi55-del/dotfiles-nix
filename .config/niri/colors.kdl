layout {
	background-color "#131314"

    focus-ring {
        active-color "#bcc8cf"
        inactive-color "#8d9194"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#bcc8cf"
        inactive-color "#8d9194"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#bcc8cf"
        inactive-color "#8d9194"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#bcc8cf80"
    }
}

overview {
	backdrop-color "#131314"
}

recent-windows {
    highlight {
        active-color "#bcc8cf"
        urgent-color "#ffb4ab"
    }
}