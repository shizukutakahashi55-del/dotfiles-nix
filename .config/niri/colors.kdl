layout {
	background-color "#0c141b"

    focus-ring {
        active-color "#87ceff"
        inactive-color "#89929a"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#87ceff"
        inactive-color "#89929a"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#87ceff"
        inactive-color "#89929a"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#87ceff80"
    }
}

overview {
	backdrop-color "#0c141b"
}

recent-windows {
    highlight {
        active-color "#87ceff"
        urgent-color "#ffb4ab"
    }
}