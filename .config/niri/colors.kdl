layout {
	background-color "#1f0f0e"

    focus-ring {
        active-color "#ffb3ac"
        inactive-color "#ad8884"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb3ac"
        inactive-color "#ad8884"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb3ac"
        inactive-color "#ad8884"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb3ac80"
    }
}

overview {
	backdrop-color "#1f0f0e"
}

recent-windows {
    highlight {
        active-color "#ffb3ac"
        urgent-color "#ffb4ab"
    }
}