layout {
	background-color "#091615"

    focus-ring {
        active-color "#00ddd4"
        inactive-color "#859492"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#00ddd4"
        inactive-color "#859492"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#00ddd4"
        inactive-color "#859492"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#00ddd480"
    }
}

overview {
	backdrop-color "#091615"
}

recent-windows {
    highlight {
        active-color "#00ddd4"
        urgent-color "#ffb4ab"
    }
}