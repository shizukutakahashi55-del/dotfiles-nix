// ============================================================================
// SYSTEM / ENVIRONMENT
// ============================================================================

// Cursor: replaces the Hyprland XCURSOR/HYPRCURSOR environment settings.
// Niri's cursor section also exports XCURSOR_THEME and XCURSOR_SIZE.
cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
}

// Qt: same intention as the Hyprland env.lua module.
environment {
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "qt6ct"

    // Electron native Wayland support was commented in the Hyprland config,
    // so it stays commented here rather than changing application behavior.
    ELECTRON_OZONE_PLATFORM_HINT "auto"

    // NVIDIA variables were intentionally left out because they are already
    // handled by the NixOS NVIDIA module in the original setup.
    

}

// Prefer applications without client-side decorations where possible.
// This is the closest Niri-level equivalent to reducing compositor-side
// decoration. Individual apps can still request CSD.
prefer-no-csd

// Niri has no Hyprland "force_default_wallpaper" or logo setting.
// Wallpapers are handled by awww/Quickshell instead.

// Screenshot path: Niri has a built-in screenshot UI, so the old Quickshell
// screenshot binds can remain available, but these paths also make Niri's
// native screenshot actions useful.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Keep Niri's overview relatively close to the compositor-oriented setup.
overview {
    zoom 0.5
    backdrop-color "#131313"
}
