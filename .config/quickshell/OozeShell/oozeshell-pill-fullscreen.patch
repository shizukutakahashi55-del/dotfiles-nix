     // ── Detección de cambio de workspace en ESTA pantalla ───────────
     readonly property var monitor: root.targetScreen ? Hyprland.monitorFor(root.targetScreen) : null
     readonly property int activeId: (root.monitor && root.monitor.activeWorkspace)
@@ -74,7 +79,7 @@
         screen: root.targetScreen
         anchors { top: true; left: true; right: true; bottom: true }
         color: "transparent"
-        visible: !Theme.barRebuilding
+        visible: !Theme.barRebuilding && !root.suppressed
 
         WlrLayershell.layer: WlrLayer.Overlay
         WlrLayershell.namespace: "oozeshell-pill-workspaces"
