#!/usr/bin/env bash
set -u

QS="${QS_BIN:-qs}"
command -v "$QS" >/dev/null 2>&1 || QS=quickshell

src="$(readlink -f "${BASH_SOURCE[0]}")"
here="$(cd "$(dirname "$src")" && pwd)"

shell_dir=""
for c in "${OOZESHELL_DIR:-}" "$here/.." "$HOME/.config/quickshell/OozeShell" "$HOME/.config/quickshell/oozeshell"; do
  if [ -n "$c" ] && [ -f "$c/shell.qml" ]; then
    shell_dir="$(cd "$c" && pwd)"
    break
  fi
done

usage() {
  cat << 'TXT'
uso:
  oozeshell <target> <funcion> [args]      oozeshell launcher toggle
  oozeshell <funcion> <target> [args]      oozeshell toggle launcher
  oozeshell open <rol>                     oozeshell open browser
  oozeshell call <target> <funcion> ...    forma larga, igual que las anteriores
  oozeshell list                           targets y funciones disponibles
  oozeshell where                          carpeta del shell que se usa

variables:
  OOZESHELL_DIR   carpeta del shell (si no está donde se espera)
  QS_BIN          binario de quickshell (por defecto qs)
TXT
}

[ $# -eq 0 ] && { usage; exit 0; }

case "$1" in
  help|-h|--help) usage; exit 0 ;;
esac

if [ -z "$shell_dir" ]; then
  echo "oozeshell: no encuentro shell.qml. Define OOZESHELL_DIR=/ruta/a/OozeShell" >&2
  exit 1
fi

case "$1" in
  where) echo "$shell_dir"; exit 0 ;;
  list|targets) exec "$QS" ipc -p "$shell_dir" show ;;
  call) shift ;;
esac

roles=" browser terminal files editor music video "

case "${1:-}" in
  toggle|open|close)
    if [ $# -ge 2 ]; then
      verb="$1"; target="$2"; shift 2
      if [ "$verb" = open ] && [[ "$roles" == *" $target "* ]]; then
        set -- apps open "$target" "$@"
      else
        set -- "$target" "$verb" "$@"
      fi
    fi
    ;;
esac

exec "$QS" ipc -p "$shell_dir" call -- "$@"
