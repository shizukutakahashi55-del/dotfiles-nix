+        clip: true
 
       ColumnLayout {
         // El layout conserva el tamaño completo; el recorte oculta lo que sobra
@@ -1105,6 +1109,7 @@
             Layout.minimumWidth: root.sidebarWidth
             Layout.fillHeight: true
             color: Qt.rgba(Theme.surface.r, Theme.surface.g, Theme.surface.b, 0.5)
+            bottomLeftRadius: cardClip.cornerR
 
             ColumnLayout {
               anchors { fill: parent; topMargin: 14; leftMargin: 10; rightMargin: 10; bottomMargin: 10 }
@@ -1213,21 +1218,38 @@
             boundsBehavior: Flickable.StopAtBounds
 
 
-            // Vuelve arriba al cambiar de categoría o reabrir
-            Behavior on contentY {
-              enabled: flick.moving === false
-              NumberAnimation { duration: Theme.animDuration(150); easing.type: Easing.OutCubic }
+            // PERF: antes había un `Behavior on contentY` aquí. Cualquier cambio de contentY
+            // que llegara con moving=false (rueda, layout, clamp) lanzaba una animación de
+            // 150 ms que peleaba con el scroll. Ahora el scroll del usuario nunca se anima y
+            // solo los saltos programáticos (anclas del buscador) usan scrollTo().
+            NumberAnimation {
+              id: gotoAnim
+              target: flick
+              property: "contentY"
+              duration: Theme.animDuration(150)
+              easing.type: Easing.OutCubic
+            }
+            function scrollTo(y) {
+              gotoAnim.stop()
+              if (!Theme.uiAnimationsEnabled || Math.abs(y - flick.contentY) < 2) { flick.contentY = y; return }
+              gotoAnim.from = flick.contentY
+              gotoAnim.to = y
+              gotoAnim.start()
             }
+            // El usuario toma el control → cancela cualquier salto en curso
+            onMovementStarted: gotoAnim.stop()
+
+            // Vuelve arriba al cambiar de categoría o reabrir (instantáneo: el contenido cambia)
             Connections {
               target: root
-              function onCategoryChanged() { flick.contentY = 0 }
-              function onOpenChanged() { if (root.open) flick.contentY = 0 }
+              function onCategoryChanged() { gotoAnim.stop(); flick.contentY = 0 }
+              function onOpenChanged() { if (root.open) { gotoAnim.stop(); flick.contentY = 0 } }
             }
 
             // Búsqueda nueva → la lista de resultados arranca desde arriba.
             Connections {
               target: root
-              function onQueryChanged() { if (root.searching) flick.contentY = 0 }
+              function onQueryChanged() { if (root.searching) { gotoAnim.stop(); flick.contentY = 0 } }
             }
 
             // Resaltado de la opción a la que se saltó desde un resultado
@@ -1259,9 +1281,10 @@
               radius: Theme.cozy ? 0 : 2
               x: flick.width - width - 4
