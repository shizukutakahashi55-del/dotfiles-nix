# CoOzey — fuentes (NixOS configuration.nix, o home-manager con `fonts.fontconfig.enable = true;`)
#
# Todo es OPCIONAL: sin estas fuentes CoOzey cae a Varela Round (incluida en el repo).
{ pkgs, ... }:
{
  fonts.packages = [
    # Íconos del shell (ya los usa todo OozeShell)
    pkgs.nerd-fonts.jetbrains-mono
    pkgs.nerd-fonts.symbols-only

    # Texto pixel — solo estas familias:
    #   PixelifySans   la que CoOzey busca primero
    #   DotGothic16    pixel con kana y kanji (idioma ja)
    (pkgs.google-fonts.override {
      fonts = [ "PixelifySans" "DotGothic16" ];
    })
  ];
}
