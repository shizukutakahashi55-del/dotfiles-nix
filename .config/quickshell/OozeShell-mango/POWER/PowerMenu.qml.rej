--- POWER/PowerMenu.qml
+++ POWER/PowerMenu.qml
@@ -299,8 +299,10 @@
         // Los clics sobre la tarjeta no deben llegar al fondo (que cierra)
         MouseArea { anchors.fill: parent }
 
-        // ❄ de marca de agua en la esquina
+        // ❄ de marca de agua en la esquina (solo OozeSoft: en CoOzey la
+        // fuente pixel lo dibujaba cortado detrás del último botón)
         Text {
+          visible: !Theme.cozy
           anchors.right: parent.right
           anchors.bottom: parent.bottom
           anchors.rightMargin: 26
@@ -324,8 +326,9 @@
             Layout.preferredWidth: 190
             Layout.preferredHeight: 190
 
-            // Aro (surface = cuerpo, outline = borde)
+            // Aro (surface = cuerpo, outline = borde). OozeSoft: círculo.
             Rectangle {
+              visible: !Theme.cozy
               anchors.fill: parent
               radius: width / 2
               color: root.cBody
@@ -333,9 +336,25 @@
               border.color: Theme.primary
             }
 
+            // CoOzey: marco CUADRADO con esquinas pixel (el círculo dejaba
+            // que las esquinas de la foto sobresalieran del aro)
+            NotchRect {
+              visible: Theme.cozy
+              anchors.fill: parent
+              topColor: Theme.primary
+              notch: 6
+            }
+            NotchRect {
+              visible: Theme.cozy
+              x: 3; y: 3
+              width: parent.width - 6; height: parent.height - 6
+              topColor: root.cBody
+              notch: 5
+            }
+
             Avatar {
               anchors.centerIn: parent
-              size: 190 - 12
+              size: 190 - (Theme.cozy ? 16 : 12)
               source: UserProfile.avatarUrl
               letter: root.userName.charAt(0).toUpperCase()
             }
@@ -348,7 +367,7 @@
               anchors.bottomMargin: 2
               width: 46
               height: 46
-              radius: 23
+              radius: Theme.cozy ? 6 : 23
               color: root.cSelected
               // Borde del color de la tarjeta: "recorta" la insignia de la foto
               border.width: 4
