{
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 30,
    "margin-top": 1,
    "margin-bottom": 1,
    "margin-left": 8,
    "margin-right": 8,

    "modules-left": ["custom/power", "power-profiles-daemon", "hyprland/language", "custom/spotify","acava"],
    "modules-center": [ "custom/notifications", "hyprland/workspaces", "clock"],
    "modules-right": [ "cpu", "memory", "custom/gpu", "pulseaudio", "bluetooth", "network", "keyboard-state", "privacy", "wlr/taskbar", "tray"],


    "hyprland/language": {
        "format": "󰌌 {}",
        "format-en": "ENG",
        "format-es": "ESP",
        "keyboard-name": "by-tech-usb-gaming-keyboard",
        "on-click": "hyprctl switchxkblayout by-tech-usb-gaming-keyboard next"
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },

    "keyboard-state": {
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "ON",   // Icono de Caps Lock activado
            "unlocked": "OFF"  // Icono de Caps Lock desactivado (o dejar vacío "")
        }
    },  

    "cava": {
        "cava_config": "/home/rinooze/.config/cava/waybar_raw",
        "framerate": 60,
        "autosens": 1,
        "bars": 12,
        "input_delay": 2,
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "actions": {
            "on-click-right": "mode"
        }
    },
    
    // "user": {
    //     "format": "{user}",
    //     "interval": 60,
    //     "height": 30,
    //     "width": 30,
    //     "icon": true,
    // },
    
    "custom/power": {
        "format": "⏻",
        "on-click": "bash ~/.config/rofi/powermenu.sh",
        "tooltip": true,
        "tooltip-format": "Power Menu"
    },

    // "custom/spotify": {
    //     "format": " 󰎈 {}",
    //     "return-type": "json",
    //     "on-click": "python ~/.config/waybar/media-popup.py 57",
    //     "on-scroll-up": "playerctl next",
    //     "on-scroll-down": "playerctl previous",
    //     "exec": "playerctl metadata --format '{\"text\": \"{{artist}} - {{title}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' --follow 2>/dev/null",
    //     "max-length": 30,
    //     "escape": true
    // },`

    // "custom/spotify": {
    //     "format": "󰎈 {}",
    //     "escape": true,
    //     "return-type": "json",
    //     "max-length": 40,
    //     "on-click": "quickshell ipc -p ~/.config/hypr/OozeShell/shell.qml call mpris toggle",
    //     //"on-click-right": "killall spotify",
    //     "smooth-scrolling-threshold": 4, // This value was tested using a trackpad, it should be lowered if using a mouse.
    //     "on-scroll-up" : "playerctl next",
    //     "on-scroll-down" : "playerctl previous",
    //     "exec": "playerctl metadata --format '{\"text\": \"{{artist}} - {{title}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' --follow 2>/dev/null", // Script in resources/custom_modules folder
    //     "exec-if": "pgrep spotify"
    // },


    "custom/spotify": {
        "format": "󰎈 {}",
        "return-type": "json",
        "escape": true,
        "max-length": 40,

        "exec": "waybar-mpris --position --autofocus",

        "on-click": "waybar-mpris --send toggle",
        "on-click-right": "waybar-mpris --send player-next",

        "on-scroll-up": "waybar-mpris --send next",
        "on-scroll-down": "waybar-mpris --send prev",

        "smooth-scrolling-threshold": 4
    },

    "clock": {
        "format": "󱑂 {:%H:%M}",
        "tooltip-format": "<span size='15000'><tt>{calendar}</tt></span>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#cba6f7'><b>{}</b></span>",
                "today": "<span color='#f9e2af'><b><u>{}</u></b></span>",
                "weekdays": "<span color='#89b4fa'><b>{}</b></span>"
            }
        }
    },
		 
	"wlr/taskbar": {
		"format": "{icon}",
		"icon-size": 16,
		"icon-theme": "Papirus-Dark",
		"tooltip-format": "{title}",
		"on-click": "activate",
		"on-click-middle": "close",
		"on-click-right": "minimize-raise",
		"all-outputs": false
	},

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "active-only": false,
        "on-click": "activate",
        "format": "{icon}",
        "format-icons": {
            "1": "󰲡",
            "2": "󰲣",
            "3": "󰲥",
            "4": "󰲧",
            "5": "󰲩",
            "urgent": "",
            "active": "󰮯",
            "default": "󰊠"
        },
        "persistent-workspaces": {
            "*": 4
        },
    },
    
    "privacy": {
        "icon-spacing": 6,
        "icon-size": 16,
        "transition-duration": 250,
        "modules": [
            { "type": "screenshare", "tooltip": true, "tooltip-icon-size": 24 },
            { "type": "audio-in", "tooltip": true, "tooltip-icon-size": 24 }
        ]
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2,
        "tooltip": true
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 2,
        "tooltip-format": "{used:0.1f}GB / {total:0.1f}GB"
    },

    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits | awk '{print $1\"%\"}'",
        "interval": 2,
        "format": "󰾲 {}",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-scroll-up": "swayosd-client --output-volume raise",
        "on-scroll-down": "swayosd-client --output-volume lower",
        "tooltip": false
    },

    "bluetooth": {
        "format": "󰂯 {status}",
        "format-connected": "󰂱 {device_alias}",
        "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
        "on-click": "bash ~/.config/rofi/launchers/type-3/bluetooth.sh",
        "tooltip-format": "{controller_alias}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "{ifname} ",
        "format-disconnected": "󰤭 offline",
        "on-click": "bash  ~/.config/rofi/rofi-network-manager.sh",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "max-length": 20
    },

    "custom/notifications": {
        "format": "󰂚 {}",
        "return-type": "json",
        "exec": "swaync-client -swb",
        "exec-if": "which swaync-client",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "restart-interval": 1,
        "escape": true,
        "tooltip": false
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    }
}
