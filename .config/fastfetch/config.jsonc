{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "~/.config/fastfetch/images/g7.png",
    "type": "sixel",
    "width": 22,
    "padding": {
      "top": 3,
      "left": 2,
      "right": 2
    }
  },

  "display": {
    "separator": " 󰄾 "
  },

  "modules": [

    // ── BANNER / HEADER ───────────────────────────────────────────────

    {
      "type": "custom",
      "format": "\u001b[90m╭──────────────────────────────󰄛──────────────────────────────╮\u001b[0m"
    },

    {
      "type": "title",
      "format": "                         \u001b[1m{user-name}@{host-name}\u001b[0m"
    },

    {
      "type": "custom",
      "format": "\u001b[90m╰──────────────────────────────󰄛──────────────────────────────╯\u001b[0m"
    },

    {
      "type": "custom",
      "format": "        \u001b[1m󰣐   󰞅   󰤄   󰅶   󰂰   󰌪   󰅵   󰂰   󰅶   󰤄   󰞅   󰣐\u001b[0m"
    },

    // ── SOFTWARE & SISTEMA ───────────────────────────────────────────

    {
      "type": "custom",
      "format": "\u001b[90m╭─\u001b[0m \u001b[1mSoftware\u001b[0m \u001b[90m──────────────────────────────────────────────────╮\u001b[0m"
    },

    {
      "type": "os",
      "key": "  󰣐 OS",
      "keyColor": "white"
    },

    {
      "type": "kernel",
      "key": "  │ ├ Kernel",
      "keyColor": "white"
    },

    {
      "type": "packages",
      "key": "  │ ├󰏖 Pkgs",
      "keyColor": "white",
      "format": "{all}"
    },

    {
      "type": "shell",
      "key": "  │ └󰞷 Shell",
      "keyColor": "white"
    },

    // ── DESKTOP & ENVIRONMENT ────────────────────────────────────────

    {
      "type": "custom",
      "format": "\u001b[90m├─\u001b[0m \u001b[1mDesktop & Environment\u001b[0m \u001b[90m──────────────────────────────────────┤\u001b[0m"
    },

    {
      "type": "de",
      "key": "  󰀻 DE",
      "keyColor": "white"
    },

    {
      "type": "wm",
      "key": "  │ ├󰨇 WM",
      "keyColor": "white"
    },

    {
      "type": "lm",
      "key": "  │ ├󰧨 LM",
      "keyColor": "white"
    },

    {
      "type": "wmtheme",
      "key": "  │ ├󰉼 Theme",
      "keyColor": "white"
    },

    {
      "type": "icons",
      "key": "  │ ├󰀻 Icons",
      "keyColor": "white"
    },

    {
      "type": "terminal",
      "key": "  │ ├󰆍 Terminal",
      "keyColor": "white"
    },

    {
      "type": "wallpaper",
      "key": "  │ └󰸉 Wallpaper",
      "keyColor": "white"
    },

    // ── HARDWARE ─────────────────────────────────────────────────────

    {
      "type": "custom",
      "format": "\u001b[90m├─\u001b[0m \u001b[1mHardware Info\u001b[0m \u001b[90m──────────────────────────────────────────────┤\u001b[0m"
    },

    {
      "type": "host",
      "key": "  󰍹 PC Host",
      "keyColor": "white"
    },

    {
      "type": "cpu",
      "key": "  │ ├󰍛 CPU",
      "keyColor": "white",
      "format": "{1}"
    },

    {
      "type": "gpu",
      "key": "  │ ├󰍛 GPU",
      "keyColor": "white",
      "format": "{2}"
    },

    {
      "type": "disk",
      "key": "  │ ├󰋊 Disk",
      "keyColor": "white",
      "format": "{1} / {2} ({3})"
    },

    {
      "type": "memory",
      "key": "  │ ├󰑭 Memory",
      "keyColor": "white"
    },

    {
      "type": "swap",
      "key": "  │ ├󰓡 Swap",
      "keyColor": "white"
    },

    {
      "type": "uptime",
      "key": "  │ ├󰅐 Uptime",
      "keyColor": "white"
    },

    // ── FOOTER ──────────────────────────────────────────────────────

    {
      "type": "custom",
      "format": "\u001b[90m╰──────────────────────────────󰣐──────────────────────────────╯\u001b[0m"
    },
    // {
    //   "type": "custom",
    //   "format": "        \u001b[1m󰣐   󰞅   󰤄   󰅶   󰂰   󰌪   󰅵   󰂰   󰅶   󰤄   󰞅   󰣐\u001b[0m"
    // }

  ]
}
