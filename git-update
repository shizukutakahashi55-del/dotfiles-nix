#!/usr/bin/env bash

# ============================================================================
#  GIT UPDATE
#
#  Usage:
#      git-update -Your commit message
#
#  Updates the Git repository associated with the current directory.
# ============================================================================

set -e

# ----------------------------------------------------------------------------
# Check commit message
# ----------------------------------------------------------------------------

if [ "$#" -eq 0 ]; then
    echo "Usage: git-update -Your commit message"
    exit 1
fi

MESSAGE="$*"

# Remove the first "-" from the message
MESSAGE="${MESSAGE#-}"

if [ -z "$MESSAGE" ]; then
    echo "[✗] Commit message cannot be empty."
    exit 1
fi

# ----------------------------------------------------------------------------
# Check Git repository
# ----------------------------------------------------------------------------

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "[✗] Current directory is not inside a Git repository."
    exit 1
fi

# ----------------------------------------------------------------------------
# Get repository root
# ----------------------------------------------------------------------------

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo
echo "=========================================="
echo "              Git Update"
echo "=========================================="
echo
echo "Repository:"
echo "  $REPO_ROOT"
echo
echo "Commit:"
echo "  $MESSAGE"
echo

# ----------------------------------------------------------------------------
# Show changes
# ----------------------------------------------------------------------------

if [ -z "$(git -C "$REPO_ROOT" status --porcelain)" ]; then
    echo "[!] No changes to commit."
    exit 0
fi

echo "Changes:"
git -C "$REPO_ROOT" status --short
echo

# ----------------------------------------------------------------------------
# Add
# ----------------------------------------------------------------------------

echo "[1/3] Adding changes..."
git -C "$REPO_ROOT" add .
echo "  [✓] Done."
echo

# ----------------------------------------------------------------------------
# Commit
# ----------------------------------------------------------------------------

echo "[2/3] Creating commit..."
git -C "$REPO_ROOT" commit -m "$MESSAGE"
echo "  [✓] Done."
echo

# ----------------------------------------------------------------------------
# Push
# ----------------------------------------------------------------------------

echo "[3/3] Pushing..."
git -C "$REPO_ROOT" push
echo "  [✓] Done."
echo

echo "=========================================="
echo "           Update complete!"
echo "=========================================="
